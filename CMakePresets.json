{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC x64 Debug (Ninja)",
      "description": "Shares cmake-build-debug with CLion's default Debug profile.",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC x64 Release (Ninja)",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "mingw-debug",
      "displayName": "MinGW g++ Debug (Ninja)",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CMAKE_C_COMPILER": "D:/MinGW/MinGW-win64-v12.0.0/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "D:/MinGW/MinGW-win64-v12.0.0/bin/g++.exe",
        "CMAKE_RC_COMPILER": "D:/MinGW/MinGW-win64-v12.0.0/bin/windres.exe"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc-debug", "configurePreset": "msvc-debug" },
    { "name": "msvc-release", "configurePreset": "msvc-release" },
    { "name": "mingw-debug", "configurePreset": "mingw-debug" }
  ],
  "testPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "mingw-debug",
      "configurePreset": "mingw-debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
