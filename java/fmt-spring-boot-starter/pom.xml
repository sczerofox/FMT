<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.lazy</groupId>
    <artifactId>fmt-java-parent</artifactId>
    <version>2.4.0</version>
    <!-- 见 fmt-client-core/pom.xml 的说明：显式给出，源码树与本地仓库两种布局都对。 -->
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>fmt-spring-boot-starter</artifactId>
  <name>FMT Spring Boot Starter</name>
  <description>把 FMT 通道接进 Spring Boot 3：一个 FmtChannel bean + 健康检查</description>

  <dependencies>
    <!--
      版本**显式写出来**，不靠父 pom 的 <dependencyManagement> 继承。
      原因：starter 的 pom 会发布给下游工程读，而继承来的版本（带 ${...} 的那些）
      **不会被 Maven 填进装好的 pom 里**——下游只看 starter 的 pom 时 core 就解析不出来
      （真机踩过：把 GitHub Release 里的两个 jar 装到干净的本地仓库后，
      编译直接「找不到 org.lazy.fmt.client」，core 根本没进 classpath）。
      显式写在 own pom 里，starter 就自包含了。升级时这一行要跟父 pom 的 <version> 一起改。
    -->
    <dependency>
      <groupId>org.lazy</groupId>
      <artifactId>fmt-client-core</artifactId>
      <version>2.4.0</version>
    </dependency>

    <!-- 自动配置基础设施 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <!--
      可选：Servlet Web 应用的 FMT 异常 → JSON 翻译（FmtExceptionAdvice）。
      只在宿主的 classpath 里有 Spring Web 时才会注册；非 Web 应用不会传递这个依赖。
    -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- 日志桥：把通道的日志出口接到宿主的 slf4j -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- 可选：宿主的 ObjectMapper（有就用来编解码，没有就退回内置 SimpleJson） -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- 可选：Actuator 健康检查（org.springframework.boot.actuate.health.HealthIndicator） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-actuator</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- 生成 fmt.* 的配置元数据，让 IDE 有提示 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- 测试 Web 条件下的自动注册；宿主没引 Web 的场景由 FilteredClassLoader 覆盖 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!--
            JDK 23+ 默认不再自动发现 classpath 上的注解处理器；显式给 processor path，
            确保 META-INF/spring-configuration-metadata.json 被生成（IDE 的 fmt.* 提示靠它）。
          -->
          <annotationProcessorPaths>
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
              <version>3.3.5</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Dfile.encoding=UTF-8</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
