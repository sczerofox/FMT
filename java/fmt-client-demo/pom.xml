<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.lazy</groupId>
    <artifactId>fmt-java-parent</artifactId>
    <version>2.3.0</version>
    <!-- 见 fmt-client-core/pom.xml 的说明：显式给出，源码树与本地仓库两种布局都对。 -->
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>fmt-client-demo</artifactId>
  <name>FMT Client Demo</name>
  <description>可执行示例：REST 桥接 + 定时从 FMT 拉取 + 自检</description>

  <dependencies>
    <dependency>
      <groupId>org.lazy</groupId>
      <artifactId>fmt-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>fmt-bridge</finalName>
    <plugins>
      <!-- 打成一个能直接 `java -jar fmt-bridge.jar` 跑的可执行 jar -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>org.lazy.fmt.demo.FmtDemoApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
